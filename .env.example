# Variáveis de ambiente do site Novera — ver specs/001-novera-site-mvp/contracts/ambiente.md
# Copie para .env.local e preencha. NUNCA versione valores reais.
# Só as variáveis NEXT_PUBLIC_* chegam ao navegador.

# URL canônica do site, sem barra final (G-01). Ex.: https://<domínio>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave pública do widget Turnstile.
# Teste "sempre aprova": 1x00000000000000000000AA  [VERIFICAR na documentação do Turnstile]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Interruptor de emergência: "nao-abertas" força o estado sem vendas. Deixe vazio no uso normal.
NEXT_PUBLIC_SALES_OVERRIDE=

# --- Somente servidor (segredos) ---

# Secret do Turnstile.
# Teste "sempre aprova": 1x0000000000000000000000000000000AA
# Teste "sempre reprova": 2x0000000000000000000000000000000AA  [VERIFICAR na documentação do Turnstile]
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Transporte de e-mail:
#   "smtp"   — qualquer provedor (Gmail, Outlook, Zoho, domínio próprio…). Recomendado.
#   "resend" — API do Resend (exige domínio verificado no Resend).
#   "fake"   — desenvolvimento e testes (grava JSON em FAKE_MAIL_DIR; bloqueado em produção).
MAIL_TRANSPORT=fake

# SMTP (MAIL_TRANSPORT=smtp). Exemplos:
#   Gmail:   smtp.gmail.com, porta 465 (ou 587), usuário = o próprio Gmail,
#            senha = "senha de app" (Conta Google → Segurança → Verificação em duas etapas → Senhas de app)
#   Outlook: smtp-mail.outlook.com, porta 587
# Porta 465 = TLS direto; 587 = STARTTLS. SMTP_SECURE força um ou outro ("true"/"false").
# A porta 25 não funciona no Cloudflare Workers.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Chave da API do Resend (só com MAIL_TRANSPORT=resend).
RESEND_API_KEY=

# Diretório onde o transporte falso grava os e-mails (desenvolvimento e testes).
FAKE_MAIL_DIR=.tmp/fake-mail

# Remetente: qualquer endereço, no formato "email@x" ou "Nome <email@x>".
# Com SMTP, use o endereço da conta autenticada (ou um alias dela); o Gmail, por exemplo,
# troca o remetente pelo da conta se for outro. Ex.: Site Novera <novera.brazil@gmail.com>
MAIL_FROM=

# Caixa da Novera que recebe avaliações e feedback (G-02). Nunca exposta no HTML.
NOVERA_INBOX_EMAIL=

# Segredo do HMAC do token de formulário (32+ caracteres aleatórios).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FORM_SIGNING_SECRET=

# "true" ativa a guarda de publicação: o build falha se houver pendências.
NOVERA_PUBLICACAO_OFICIAL=

# Só no deploy pelo CI: "true" faz a guarda conferir apenas as variáveis de build
# (os segredos ficam no Worker e são conferidos com `npx wrangler secret list`).
NOVERA_GUARDA_SOMENTE_BUILD=
